     * e filtro passa-basso dinamico anti-clipping.
     */
    class IntervalAudioEngine {
      constructor() {
        this.ctx = null;
        this.masterGain = null;
      }

      init() {
        if (!this.ctx) {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioContextClass();
          
          this.masterGain = this.ctx.createGain();
          this.masterGain.gain.setValueAtTime(0.35, this.ctx.currentTime);
          this.masterGain.connect(this.ctx.destination);
        }

        if (this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      midiToFreq(midi) {
        return 440 * Math.pow(2, (midi - 69) / 12);
      }

      /**
       * Riproduce una singola nota con armoniche sommate e inviluppo dolce
       */
      playNote(midiNote, startTime = 0, duration = 1.2) {
        this.init();
        const t = this.ctx.currentTime + startTime;
        const freq = this.midiToFreq(midiNote);

        // Sub-mix per la singola nota
        const noteGain = this.ctx.createGain();
        noteGain.connect(this.masterGain);

        // Filtro dinamico passa-basso per smussare le frequenze alte
        const filter = this.ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(freq * 4.5, t);
        filter.frequency.exponentialRampToValueAtTime(freq * 1.5, t + duration);
        filter.connect(noteGain);

        // 1. Fondamentale (Sine)
        const osc1 = this.ctx.createOscillator();
        osc1.type = 'sine';
        osc1.frequency.setValueAtTime(freq, t);

        // 2. Seconda armonica (Triangle morbido a volume ridotto)
        const osc2 = this.ctx.createOscillator();
        osc2.type = 'triangle';
        osc2.frequency.setValueAtTime(freq * 2, t);
        const osc2Gain = this.ctx.createGain();
        osc2Gain.gain.setValueAtTime(0.25, t);
        osc2.connect(osc2Gain);
        osc2Gain.connect(filter);

        // Inviluppo ADSR
        const attack = 0.015;
        const decay = duration * 0.85;

        noteGain.gain.setValueAtTime(0.0001, t);
        noteGain.gain.exponentialRampToValueAtTime(0.9, t + attack);
        noteGain.gain.exponentialRampToValueAtTime(0.0001, t + attack + decay);

        osc1.connect(filter);

        osc1.start(t);
        osc2.start(t);

        osc1.stop(t + duration + 0.1);
        osc2.stop(t + duration + 0.1);
      }

      /**
       * Riproduce un intervallo melodico o armonico
       */
      playInterval(rootMidi, semitones, direction = 'asc') {
        this.init();
        const targetMidi = rootMidi + semitones;

        if (direction === 'asc') {
          // Nota 1 poi Nota 2 (salita)
          this.playNote(rootMidi, 0, 0.9);
          this.playNote(targetMidi, 0.45, 1.4);
        } else if (direction === 'desc') {
          // Nota 2 poi Nota 1 (discesa)
          this.playNote(targetMidi, 0, 0.9);
          this.playNote(rootMidi, 0.45, 1.4);
        } else if (direction === 'harm') {
          // Suonate simultaneamente
          this.playNote(rootMidi, 0, 1.5);
          this.playNote(targetMidi, 0, 1.5);
        }
      }

      playRoot(rootMidi) {
        this.init();
        this.playNote(rootMidi, 0, 1.4);
      }
    }
  </script>

